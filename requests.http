  "patient_id": "P002",
  "receiver_id": 2
}

### 9. Hospital B views received encrypted records
@tokenB = PASTE_ACCESS_TOKEN_B_HERE

GET {{baseUrl}}/api/privacy/encryption/received/
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzgyMDY0MjkwLCJpYXQiOjE3ODIwNjA2OTAsImp0aSI6ImEyYWFhMDk1NjEzMjRhOTBiNWZlNmI1ZTdiMWE3ZDUwIiwidXNlcl9pZCI6IjMifQ.yaBsxfLB5YA1loCpPUi4Ji3Va531uefGWiXJV6q2dqQ

