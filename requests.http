@baseUrl = http://127.0.0.1:8000

### 1. Register Hospital A

POST {{baseUrl}}/api/organisations/register/
Content-Type: application/json

{
  "username": "hospitalA",
  "password": "Test1234@#",
  "email": "hospitalA@example.com",
  "name": "Hospital A",
  "organisation_type": "hospital",
  "location": "Korle Bu"
}

### 2. Register Hospital B
POST {{baseUrl}}/api/organisations/register/
Content-Type: application/json

{
  "username": "hospitalB",
  "password": "testpass123",
  "email": "hospitalB@example.com",
  "name": "Hospital B",
  "organisation_type": "hospital",
  "location": "Komfo Anokye"
}

### 3. Login Hospital A
# @name loginA
POST {{baseUrl}}/api/token/
Content-Type: application/json

{
  "username": "hospitalA",
  "password": "Test1234@#"
}

### 4. Login Hospital B
# @name loginB
POST {{baseUrl}}/api/token/
Content-Type: application/json

{
  "username": "hospitalB",
  "password": "testpass123"
}

### 5. Refresh Hospital A's token (replace REFRESH_TOKEN_A manually)
POST {{baseUrl}}/api/token/refresh/
Content-Type: application/json

{
  "refresh": "REFRESH_TOKEN_A"
}

### 6. Create a patient under Hospital A
@tokenA = PASTE_ACCESS_TOKEN_A_HERE

POST {{baseUrl}}/api/patients/
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzgyMDYzNTkzLCJpYXQiOjE3ODIwNTk5OTMsImp0aSI6IjE3OTUwNGY2MWJlZTRhOGE4NDdiZWFlMjc3MDkwNmEzIiwidXNlcl9pZCI6IjIifQ.GrWEwSsWXy3M_7qfdkhLMkz49bz_u0OuATBU7Gf3tR0

{
  "patient_id": "P002",
  "name": "Kojo Ofoe",
  "age": 40,
  "gender": "M",
  "diagnosis": "Hypertension",
  "medication": "Lisinopril"
}

### 7. List Hospital A's patients
GET {{baseUrl}}/api/patients/
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzgyMDY2NDk5LCJpYXQiOjE3ODIwNjI4OTksImp0aSI6IjcwOThlODdhNjQ4YTRhNjU4OTk0NTQxYTY1YzE1NDlmIiwidXNlcl9pZCI6IjIifQ.v3BE2vnF1NchC3liHD-bBcH9vZyCAg0kKvXT0MldkOw
### 8. Send encrypted record from Hospital A to Hospital B
POST {{baseUrl}}/api/privacy/encryption/send/
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzgyMDY2NDk5LCJpYXQiOjE3ODIwNjI4OTksImp0aSI6IjcwOThlODdhNjQ4YTRhNjU4OTk0NTQxYTY1YzE1NDlmIiwidXNlcl9pZCI6IjIifQ.v3BE2vnF1NchC3liHD-bBcH9vZyCAg0kKvXT0MldkOw

